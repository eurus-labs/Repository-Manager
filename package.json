{
  "name": "repository-manager",
  "displayName": "Repository Manager",
  "description": "Coordinate branches and Git workflows across a parent repository and its linked repositories from one VS Code dashboard",
  "version": "2.20.0",
  "publisher": "repository-manager",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "repository",
    "multi-repository",
    "workflow",
    "branch-management",
    "submodule",
    "branch",
    "sync",
    "pull request"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "workspaceContains:.git",
    "workspaceContains:.gitmodules"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repositoryManager.openPanel",
        "title": "Open Repository Manager",
        "category": "Repository Manager",
        "icon": "$(window)"
      },
      {
        "command": "repositoryManager.forgetReviewPermissions",
        "title": "Forget Review Permissions",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.removeDiscardCopies",
        "title": "Remove Discard Copies",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.refresh",
        "title": "Refresh Repositories",
        "category": "Repository Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "repositoryManager.initSubmodules",
        "title": "Initialize All Submodules",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.updateSubmodules",
        "title": "Update All Submodules",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.createBranch",
        "title": "Create Branch Across Repositories",
        "category": "Repository Manager",
        "icon": "$(git-branch)"
      },
      {
        "command": "repositoryManager.syncVersions",
        "title": "Align Linked Repositories with Recorded Commits",
        "category": "Repository Manager",
        "icon": "$(sync)"
      },
      {
        "command": "repositoryManager.openSubmodule",
        "title": "Open Repository in Explorer",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.pullChanges",
        "title": "Pull Changes",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.pushChanges",
        "title": "Push Changes",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.createPR",
        "title": "Create Pull Request",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.stageSubmodule",
        "title": "Stage Submodule Changes",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.deleteBranch",
        "title": "Delete Branch",
        "category": "Repository Manager",
        "icon": "$(trash)"
      },
      {
        "command": "repositoryManager.deleteBranchFromTree",
        "title": "Delete Branch",
        "category": "Repository Manager",
        "icon": "$(trash)"
      },
      {
        "command": "repositoryManager.deleteBranchAcrossSubmodules",
        "title": "Delete Branch Across Repositories",
        "category": "Repository Manager",
        "icon": "$(trash)"
      },
      {
        "command": "repositoryManager.requirements.newFile",
        "title": "New Clarification File",
        "category": "Repository Manager",
        "icon": "$(new-file)"
      },
      {
        "command": "repositoryManager.requirements.refresh",
        "title": "Refresh Requirements",
        "category": "Repository Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "repositoryManager.requirements.openAsText",
        "title": "Open as Markdown Text",
        "category": "Repository Manager",
        "icon": "$(go-to-file)"
      },
      {
        "command": "repositoryManager.requirements.filterClarifications",
        "title": "Filter Clarifications…",
        "category": "Repository Manager",
        "icon": "$(filter)"
      },
      {
        "command": "repositoryManager.requirements.filterRequirements",
        "title": "Filter Requirements…",
        "category": "Repository Manager",
        "icon": "$(filter)"
      },
      {
        "command": "repositoryManager.requirements.newItem",
        "title": "New Clarification",
        "category": "Repository Manager",
        "icon": "$(add)"
      },
      {
        "command": "repositoryManager.requirements.changeSource",
        "title": "Change Requirements Source…",
        "category": "Repository Manager",
        "icon": "$(gear)"
      },
      {
        "command": "repositoryManager.requirements.reveal",
        "title": "Show in Requirement Editor",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.requirements.newItemFor",
        "title": "New Clarification for This Requirement",
        "category": "Repository Manager",
        "icon": "$(add)"
      },
      {
        "command": "repositoryManager.deleteBranchFromMenu",
        "title": "Delete Branch…",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.showUsage",
        "title": "Show Usage Report",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.clearUsage",
        "title": "Clear Usage Data",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.studio.runWorkflow",
        "title": "Run Workflow…",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.studio.showRuns",
        "title": "Show Workflow Runs",
        "category": "Repository Manager"
      },
      {
        "command": "repositoryManager.studio.newChat",
        "title": "New Studio Chat",
        "category": "Repository Manager",
        "icon": "$(add)"
      },
      {
        "command": "repositoryManager.studio.chatHistory",
        "title": "Studio Chat History",
        "category": "Repository Manager",
        "icon": "$(history)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repository-manager",
          "title": "Repository Manager",
          "icon": "resources/activitybar-icon.svg"
        },
        {
          "id": "repository-manager-requirements",
          "title": "Requirements",
          "icon": "resources/requirements-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "repository-manager-studio",
          "title": "Studio",
          "icon": "resources/agent-icon.svg"
        }
      ]
    },
    "views": {
      "repository-manager": [
        {
          "type": "webview",
          "id": "repositoryManager.launcher",
          "name": "Repository Manager",
          "contextualTitle": "Repository Manager"
        }
      ],
      "repository-manager-requirements": [
        {
          "id": "repositoryManager.requirementsCatalog",
          "name": "Requirements",
          "contextualTitle": "Requirements"
        },
        {
          "id": "repositoryManager.requirements",
          "name": "Clarifications",
          "contextualTitle": "Requirements"
        }
      ],
      "repository-manager-studio": [
        {
          "type": "webview",
          "id": "repositoryManager.studio.chat",
          "name": "Chat",
          "contextualTitle": "Studio"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "repositoryManager.refresh",
          "when": "view == repositoryManager.launcher",
          "group": "navigation@1"
        },
        {
          "command": "repositoryManager.openPanel",
          "when": "view == repositoryManager.launcher",
          "group": "navigation@2"
        },
        {
          "command": "repositoryManager.requirements.newFile",
          "when": "view == repositoryManager.requirements",
          "group": "navigation@1"
        },
        {
          "command": "repositoryManager.requirements.filterClarifications",
          "when": "view == repositoryManager.requirements",
          "group": "navigation@2"
        },
        {
          "command": "repositoryManager.requirements.refresh",
          "when": "view == repositoryManager.requirements",
          "group": "navigation@3"
        },
        {
          "command": "repositoryManager.requirements.filterRequirements",
          "when": "view == repositoryManager.requirementsCatalog",
          "group": "navigation@1"
        },
        {
          "command": "repositoryManager.requirements.changeSource",
          "when": "view == repositoryManager.requirementsCatalog",
          "group": "navigation@2"
        },
        {
          "command": "repositoryManager.studio.newChat",
          "when": "view == repositoryManager.studio.chat",
          "group": "navigation@1"
        },
        {
          "command": "repositoryManager.studio.chatHistory",
          "when": "view == repositoryManager.studio.chat",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "repositoryManager.openPanel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "repositoryManager.requirements.openAsText",
          "when": "false"
        },
        {
          "command": "repositoryManager.requirements.reveal",
          "when": "false"
        },
        {
          "command": "repositoryManager.requirements.newItemFor",
          "when": "false"
        },
        {
          "command": "repositoryManager.deleteBranchFromMenu",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "repositoryManager.requirements.newItem",
          "when": "view == repositoryManager.requirements && viewItem == clarificationFile",
          "group": "inline@1"
        },
        {
          "command": "repositoryManager.requirements.openAsText",
          "when": "view == repositoryManager.requirements && viewItem =~ /^clarificationFile/",
          "group": "inline@2"
        },
        {
          "command": "repositoryManager.requirements.newFile",
          "when": "view == repositoryManager.requirements && viewItem =~ /^clarificationFile/",
          "group": "1_new"
        },
        {
          "command": "repositoryManager.requirements.newItemFor",
          "when": "view == repositoryManager.requirementsCatalog && viewItem == requirement",
          "group": "inline@1"
        }
      ],
      "webview/context": [
        {
          "command": "repositoryManager.deleteBranchFromMenu",
          "when": "webviewId == 'repositoryManager.launcher' && webviewSection == 'localBranch'"
        }
      ]
    },
    "configuration": {
      "title": "Repository Manager",
      "properties": {
        "repositoryManager.defaultBranch": {
          "type": "string",
          "default": "main",
          "description": "Default branch name for new branches"
        },
        "repositoryManager.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "Fetch all repositories in the background while the dashboard is visible, so ahead/behind counts stay current. Background fetches never prune deleted remote branches (the Fetch button does) and turn off credential prompts (Git's terminal prompt and askpass, SSH askpass, Git Credential Manager); a repository that needs credentials is skipped."
        },
        "repositoryManager.autoFetchInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Minutes between background fetches when repositoryManager.autoFetch is enabled."
        },
        "repositoryManager.liveChanges": {
          "type": "boolean",
          "default": true,
          "description": "Keep local changes current while you edit: saving, creating or deleting files (and staging with Git) refreshes the dashboard's uncommitted changes and change counts about a second later. Turn off in very large repositories where git status is slow; Refresh still updates them."
        },
        "repositoryManager.copilot.askBeforeSending": {
          "type": "string",
          "enum": [
            "never",
            "oncePerRepository",
            "always"
          ],
          "enumItemLabels": [
            "Never ask",
            "Ask once per repository",
            "Ask every time"
          ],
          "enumDescriptions": [
            "Send code to the selected Copilot model without asking.",
            "Ask the first time in each repository; \"Always allow for this repository\" stops asking there, until \"Repository Manager: Forget Review Permissions\".",
            "Ask before every request that sends code to Copilot."
          ],
          "default": "never",
          "markdownDescription": "When to ask before code is sent to the selected Copilot model: reviews, auto-fixes, explanations of findings, summaries and commit messages. Also in the dashboard's ⚙ menu next to **Model**. VS Code itself may ask once whether Repository Manager may use language models."
        },
        "repositoryManager.review.confirmBeforeSending": {
          "type": "boolean",
          "default": false,
          "description": "Ask before every request that sends code to Copilot.",
          "markdownDeprecationMessage": "Use `#repositoryManager.copilot.askBeforeSending#` instead. While that setting is not set, `true` here still means **Ask every time**."
        },
        "repositoryManager.debug.timings": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write how long opening the dashboard takes to the **Repository Manager Timings** output: each step (page shown, history asked and sent, repositories listed, history drawn) and every Git command with its duration, for the first 30 seconds. For finding out why the dashboard opens slowly; off by default."
        },
        "repositoryManager.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for git operations"
        },
        "repositoryManager.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub personal access token for PR operations"
        },
        "repositoryManager.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record, on this machine only, how long commits from the dialog take, whether Copilot wrote the message and how much of it you changed, Align runs and applied review fixes (counts and durations; no paths, messages or code). See Show Usage Report."
        },
        "repositoryManager.studio.skillSources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "default": [
            "eurus-labs/skills"
          ],
          "markdownDescription": "GitHub repositories (`owner/name`) whose skills (folders with a `SKILL.md`) the Studio offers for its steps. Read with your VS Code GitHub sign-in; each repository is trusted once before its skills are used. Skills' scripts are never run."
        }
      }
    },
    "keybindings": [
      {
        "command": "repositoryManager.openPanel",
        "key": "ctrl+shift+g m",
        "mac": "cmd+shift+g m"
      },
      {
        "command": "repositoryManager.refresh",
        "key": "ctrl+shift+g r",
        "mac": "cmd+shift+g r"
      }
    ],
    "viewsWelcome": [
      {
        "view": "repositoryManager.requirements",
        "contents": "No clarification files in this workspace yet. A clarification file records questions about requirements, with their answers and the acceptance criteria the PO decides.\n[New Clarification File](command:repositoryManager.requirements.newFile)"
      },
      {
        "view": "repositoryManager.requirementsCatalog",
        "contents": "Open a clarification file to see the requirements its items clarify, and which of them are Ready."
      }
    ],
    "customEditors": [
      {
        "viewType": "repositoryManager.requirementEditor",
        "displayName": "Requirement Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "repositoryManager.workflowEditor",
        "displayName": "Workflow Editor",
        "selector": [
          {
            "filenamePattern": "*.workflow.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js && node ./src/test/summaryWebviewSmoke.js && node ./src/test/historyActionHandlerSmoke.js && node ./src/test/historyRewriteHandlerSmoke.js && node ./src/test/conflictPredictionSmoke.js && node ./src/test/conflictExplanationSmoke.js && node ./src/test/conflictResolutionSmoke.js && node ./src/test/naturalUndoSmoke.js && node ./src/test/syncRecordedHandlerSmoke.js && node ./src/test/pullChangesSmoke.js && node ./src/test/autoFetchPanelSmoke.js && node ./src/test/backgroundFetchSmoke.js && node ./src/test/summaryProviderSmoke.js && node ./src/test/reviewSnapshotSmoke.js && node ./src/test/securityReviewSmoke.js && node ./src/test/securityReviewFindingsSmoke.js && node ./src/test/reviewReportSmoke.js && node ./src/test/reviewControllerSmoke.js && node ./src/test/reviewConsentSmoke.js && node ./src/test/reviewFixSmoke.js && node ./src/test/reviewLimitationsSmoke.js && node ./src/test/historyUpstreamSmoke.js && node ./src/test/reviewHistorySmoke.js && node ./src/test/reviewConversationSmoke.js && node ./src/test/historySearchSmoke.js && node ./src/test/repositoryListSmoke.js && node ./src/test/branchDeleteHandlerSmoke.js && node ./src/test/sidebarViewSmoke.js && node ./src/test/reviewResumeSmoke.js && node ./src/test/reviewSkillsSmoke.js && node ./src/test/reviewTriageCarrySmoke.js && node ./src/test/reviewBridgeSmoke.js && node ./src/test/commitHandlerSmoke.js && node ./src/test/commitMessageSmoke.js && node ./src/test/usageLogSmoke.js && node ./src/test/liveChangesSmoke.js && node ./src/test/reviewFileCoverageSmoke.js && node ./src/test/reviewExplainSmoke.js && node ./src/test/aiDirectedTextSmoke.js && node ./src/test/reviewRetrySmoke.js && node ./src/test/reviewSnapshotKeepSmoke.js && node ./src/test/stashSmoke.js && node ./src/test/stashActionSmoke.js && node ./src/test/discardSmoke.js && node ./src/test/changeDocumentsSmoke.js && node ./src/test/dashboardOpenSmoke.js && node ./src/test/pushCreatedBranchesSmoke.js && node ./src/test/modelPreferencesSmoke.js && node ./src/test/requirementsParserSmoke.js && node ./src/test/requirementsViewSmoke.js && node ./src/test/activationSmoke.js && node ./src/test/agentHarnessSmoke.js && node ./src/test/studioEngineSmoke.js && node ./src/test/studioCommandsSmoke.js && node ./src/test/workflowEditSmoke.js && node ./src/test/studioChatSmoke.js && node ./src/test/studioSkillsSmoke.js && node ./src/test/studioCodeStepSmoke.js && node ./src/test/agentMigrationSmoke.js",
    "test:ui": "npm run compile && node ./src/test/uiSnapshots.js && node ./src/test/requirementEditorUi.js && node ./src/test/studioEditorUi.js && node ./src/test/studioChatUi.js",
    "package": "vsce package",
    "bench:load": "node ./src/test/loadBench.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.0.0",
    "playwright-core": "~1.56.1",
    "sharp": "^0.35.5",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eurus-labs/Repository-Manager"
  },
  "bugs": {
    "url": "https://github.com/eurus-labs/Repository-Manager/issues"
  },
  "homepage": "https://github.com/eurus-labs/Repository-Manager#readme",
  "license": "MIT"
}
